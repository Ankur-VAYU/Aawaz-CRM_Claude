NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aawaz

# Secret for signing access tokens. Use a long random value in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of allowed browser origins (mobile apps don't need CORS). "*" allows all.
CORS_ORIGIN=*

# When false, only admins can create accounts (via POST /api/v1/users).
ALLOW_PUBLIC_SIGNUP=true

# Used by `npm run seed:admin` to create the first admin account
ADMIN_EMAIL=admin@aawaz.app
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Aawaz Admin
