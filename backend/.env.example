NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aawaz

# Secrets: use long random values in production, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
OTP_SECRET=change-me-to-another-long-random-string-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SECONDS=300

# Development only: include the OTP in the /auth/otp/request response (no SMS/WhatsApp needed).
OTP_DEV_ECHO=true

# Where customers open receipt and khata links
PUBLIC_BASE_URL=http://localhost:3000

# Comma-separated list of allowed browser origins (mobile apps don't need CORS). "*" allows all.
CORS_ORIGIN=*

# Run the message sender + daily summary scheduler in this process
RUN_WORKERS=true
